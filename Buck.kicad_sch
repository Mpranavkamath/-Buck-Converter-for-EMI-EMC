		(uuid "89ff531e-2a6d-4a34-94b5-bca4d67b4b95")
	)
	(text "Specs chosen:\n10W converter,CCM\nVin=12-24V\nVout=5V\nfsw=37kHz with +/-3kHz and 1kHz step\n\n\n"
		(exclude_from_sim no)
		(at 204.978 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a3bd2dd9-9b37-4aaa-925e-38e3c24eaaf9")
	)
	(text "Mosfet selection\nVDS\nID\nRDS\n\nVbreakdown=12*margin(0.2 or 0.3)=16V standard =20V\n\nVin=12V ,10W Iin (it is avg!)=10/12=0.834A\nVout=5V,10W,Iout=2A\nIDS(low side)=6A to 12 A(select between safety factor of 3, 6)\n\nlosses=switching+conduction\n\nPcond=Ids^2*Rds\nAssuming an efficiency of 95% of 10W out,input=10.52W\nlosses allowed=526.3mW\nassuming 1/3 losses from 2 mosfets\nPloss=87.8mW=>Pcond=Ploss/2\nPcond=Ids^2*Rds\nacceptable Rds=63.056mOhm\n\nHigher Ids->lower Rds->bigger die->larger gate capacitance\nGate drive power per FET is Qg × Vgs × fsw:\n15 nC × 5 V × 37 kHz ~ 2.71 mW\n\nHigher Vds->higher Rds\n"
		(exclude_from_sim no)
		(at 206.502 53.594 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a5085859-7d9d-494a-aba7-8b3111a36ef5")
	)
	(text "delta(ICout)=(12V/1*37kHz)*((1-0.4166)/120uH)\ndeltaIcout=1.577A"
		(exclude_from_sim no)
		(at 257.048 70.866 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "aa312d56-11cd-4d9c-a4af-2b45551a49d9")
	)
	(text "L1=((5)*(1-0.5))/(37kHz)(0.40*2A)\n=>L1=84.5uH\n"
