				(size 1.27 1.27)
			)
		)
		(uuid "2933bc48-9ffb-4a7a-a1d5-26cf3491dfe9")
	)
	(text "minimum output capacitance for 1st crieteria(Cout)(for 200uH inductor):\nCout=53.02uF(120/200)\nCout=31.812uF"
