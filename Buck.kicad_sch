	)
	(text "minimum output capacitance for 1st crieteria(Cout):\nCout=(1-0.411)/(delta(VCout)/5V)*8*120uH*(1*34kHz)^2\nCout=0.5884/((delta(VCout)/5V)*0.00096*(1156M)\n\n(delta(VCout) taken as 1% of Vout: 5*0.01=50mV)(considered fmin=34kHz)\nCout=0.5884/((50mV/5V)*0.00096*(1156M)\nCout=53.02uF"
		(exclude_from_sim no)
		(at 258.064 111.252 0)
		(effects
